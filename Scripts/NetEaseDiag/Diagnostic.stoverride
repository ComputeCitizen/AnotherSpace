name: 网易云请求路径探针 v2
# 仅诊断请求是否经过 Stash；不修改任何数据。
desc: 捕获网易云域名下的 HTTP 请求路径，排查旧诊断规则未命中问题。
author: Stash Diagnostic
version: "2026.11.18-v2"

http:
  mitm:
    - "*.music.163.com"
    - "music.163.com"
  script:
    - match: ^https?:\/\/(?:[^\/]+\.)?music\.163\.com\/
      name: ncm-path-probe-20261118-v2
      type: request
      engine: webkit
      timeout: 10

script-providers:
  ncm-path-probe-20261118-v2:
    path: ./scripts/ncm-path-probe-20261118-v2.js
    payload: |
      // Stash diagnostic: log only domain and path, never query/cookies.
      try {
        var url = String($request.url || "");
        var withoutQuery = url.split("?")[0].split("#")[0];
        var location = withoutQuery.replace(/^https?:\/\//, "");
        console.log("[NCM-PROBE] " + location);
      } catch (e) {
        console.log("[NCM-PROBE] error=" + String(e && e.name || "Error"));
      }
      $done({});
