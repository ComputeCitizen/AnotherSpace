name: Spotify解锁(2026.02.02)
desc: 基于daozen仓库规则转换。去除广告、假显示Premium。建议登录后开启并重启App。
icon: https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Spotify.png
category: 去广告
date: "2026-02-02 10:01:01"

http:
  mitm:
    - "spclient.wg.spotify.com"
    - "*spclient.spotify.com"
    - "*.wg.spotify.com"
    - "*.spotify.com"
    - "guc3-spclient.spotify.com:443"

  script:
    # 1. Header 修正
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$
      name: spotify_core_header
      type: request
      timeout: 10

    # 2. Premium 核心破解 (仅匹配 bootstrap 和 customize)
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$
      name: spotify_core_proto
      type: response
      require-body: true
      binary-mode: true
      timeout: 10

    # 3. JSON (歌手专辑列表修正)
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/
      name: spotify_core_json
      type: request
      timeout: 10

    # 4.消除中间广告
    #- match: ^https:\/\/.*spotify\.com\/.*pendragon.*FetchMessageList
    #  name: spotify_clean_upsell
    #  type: response
    #  require-body: true
    #  binary-mode: true
    #  timeout: 10

    # ================= 🛡️ 第一道防线：源头阻断 (去框关键) =================
    # 拦截广告配置接口，告诉 App "没有广告"，从而防止首页挖坑
    # 匹配 /ads/v1, /ad-logic/, /slots/ 等常见广告配置路径
    - match: ^https:\/\/.*spotify\.com\/.*(ads\/v1|ad-logic\/|InAppMessageService)
      name: spotify_clean_upsell
      type: response
      require-body: true
      timeout: 10

    # ================= 🛡️ 第二道防线：内容清空 (兜底) =================
    # 如果框还在，至少把内容清空 (就是你刚才用的那个)
    - match: ^https:\/\/.*spotify\.com\/.*pendragon.*FetchMessageList
      name: spotify_clean_upsell
      type: response
      require-body: true
      timeout: 10

    # ================= 🛡️ 第三道防线：禁止跳转 (防手误) =================
    # 万一框还在，点击后直接报错，不让它打开浏览器加载 DoubleClick
    - match: ^https?:\/\/.*(doubleclick\.net|googleadservices\.com|pagead)
      name: reject_ad_click
      type: reject


script-providers:
  spotify_core_header:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-qx-header.js
    interval: 86400
  spotify_core_proto:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-proto.js
    interval: 86400
  spotify_core_json:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-json.js
    interval: 86400
  spotify_clean_upsell:
    url: https://raw.githubusercontent.com/ComputeCitizen/AnotherSpace/release/Scripts/VIP/SpotifyAds.js
    interval: 86400
    
