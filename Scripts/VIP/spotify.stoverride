name: Spotify解锁(2026.02.02)
desc: 基于daozen仓库规则转换。去除广告、假显示Premium。建议登录后开启并重启App。
icon: https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Spotify.png
category: 去广告
date: "2026-02-02 10:01:01"

http:
  mitm:
    - "spclient.wg.spotify.com"
    - "*spclient.spotify.com"
    - "*.wg.spotify.com"
    - "*.spotify.com"

  script:
    # 0. 去广告
    - match: ^https:\/\/.*spotify\.com\/.*pendragon.*FetchMessageList
      name: reject_upsell
      type: reject
    # 1. Header
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$
      name: spotify_core_header
      type: request
      timeout: 10

    # 2. Proto
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$
      name: spotify_core_proto
      type: response
      require-body: true
      binary-mode: true
      timeout: 10

    # 3. JSON (列表修正)
    - match: ^https:\/\/((gae2-)?spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/
      name: spotify_core_json
      type: request
      timeout: 10


script-providers:
  spotify_core_header:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-qx-header.js
    interval: 86400
  spotify_core_proto:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-proto.js
    interval: 86400
  spotify_core_json:
    url: https://raw.githubusercontent.com/daozen/rules/master/js/spotify-json.js
    interval: 86400
 
