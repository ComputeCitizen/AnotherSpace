name: |-
  网易云音乐净化 v0.1.2
desc: |-
  基于 ddgksf2013/Rewrite 的网易云净化逻辑，改为 Stash WebKit + binary-mode。
author: |-
  ddgksf2013 / Stash Adaptation
version: |-
  1.0.34-stash-full
lastModified: |-
  2026-09-29
homepage: |-
  https://github.com/ddgksf2013/Rewrite

http:
  mitm:
    - "interface.music.163.com"
    - "interface1.music.163.com"
    - "interface2.music.163.com"
    - "interface3.music.163.com"

  url-rewrite:
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/content\/activity\/music\/jar\/template\/list - reject-200
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/sp\/flow\/popup\/query - reject-200
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipmall\/couponcfg\/get - reject-200
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/w?eapi\/(resource-exposure\/)?activity - reject-200
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/comment\/feed\/inserted\/resources - reject-200
    - >-
      ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/resource-exposure\/config - reject-200

  script:

    # 底部Tab
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/home\/framework\/tab
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 发现页
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/discovery\/resource\/show
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 首推荐页
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/page\/rcmd\/resource\/show
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 软件更新
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ios\/upgrade\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 搜索默认填词
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/default\/keyword\/list
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 猜你喜欢
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/rcmd\/keyword\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 搜索下方Chart
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/chart\/list
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 搜索Chart
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/chart\/detail
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 相关搜索
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/suggest\/keyword\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 特殊词
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/search\/specialkeyword\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 广告加载
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ad\/loading\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 广告实时
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ad\/loading\/current
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 广告Get
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/ad\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 插入广告
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/position\/show\/resource
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 歌单顶部广告
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/link\/scene\/show\/resource
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 弹窗免费听歌
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vip\/cashier\/tspopup\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧栏账户
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/vipnewcenter\/app\/resource\/newaccountpage
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧栏推广
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/side-bar\/mini-program\/music-service\/account
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧边VIP推广
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/delivery\/deliver
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧边浮层
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/delivery\/batch-deliver
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧边兑换黑胶Tips
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/yunbei\/account\/entrance\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 侧边创作福利
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/creator\/musician\/reminder\/message\/get
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

    # 评论区插入推广 / Batch
    - match: ^https?:\/\/interface(\d)?\.music\.163\.com\/e?api\/batch
      name: "netease-adblock"
      type: response
      require-body: true
      binary-mode: true
      engine: webkit
      timeout: 60
      max-size: 5242880

script-providers:
  "netease-adblock":
    url: https://raw.githubusercontent.com/ComputeCitizen/AnotherSpace/refs/heads/release/Scripts/VIP/netease-adblock.js
    interval: 86400
