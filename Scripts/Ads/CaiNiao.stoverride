name: ComputeCitizen-菜鸟&闲鱼-去广告（重写稳妥版）
desc: 基于 ddgksf2013 规则逐条移植到 Stash；闲鱼的 jsonjq 改为直接拒绝或精简兜底
icon: https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/Cainiao.png
category: 去广告
date: "2025-09-27 10:00:00"

http:
  mitm:
    # 来自“菜鸟裹裹”脚本头：hostname=*.cainiao.com, guide-acs.m.taobao.com, acs4miniapp-inner.m.taobao.com
    # Stash 不支持通配 *.cainiao.com，这里覆盖主要用到的域：
    - "cn-acs.m.cainiao.com"
    - "guide-acs.m.taobao.com"
    - "acs4miniapp-inner.m.taobao.com"
    - "amdc.m.taobao.com"
    # 来自“闲鱼”脚本头：
    - "acs.m.goofish.com"
    - "g-acs.m.goofish.com"

  rewrite:
    # ========== 菜鸟裹裹 / 支付宝小程序部分（逐条等价转换） ==========

    # [amdc 处理]（原：^http://amdc.m.taobao.com url script-response-body amdc.js）
    # 这里先不脚本，A 版主打“稳”，仅保留脚本版在 B 中；A 版不写等价 rewrite

    # [我的页面去推广：engine.page.fetch 用脚本处理（A 版不改，见 B 版）]

    # [首页中部问邻居推广]（原走脚本；A 版不处理，见 B 版）

    # [首页惊喜福利推广]（原走脚本；A 版不处理，见 B 版）

    # [搜索框下方今日好物推荐]（原走脚本；A 版不处理，见 B 版）

    # [通用广告请求]  原：^https?://[...].cainiao.com/gw/mtop.cainiao.guoguo.nbnetflow.ads.(?!.*_home) url reject-200
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.(?!.*_home) - reject-dict

    # [首页底部商品推广] 原：.../mtop.cainiao.nbcps.presentation.fetch.cn url reject-200
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn - reject-dict

    # [支付宝小程序-通用广告请求]
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\. - reject-dict

    # [支付宝小程序-底部商品推广 新]
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.alimama\.abyss\.unionpage\.get - reject-dict

    # [支付宝小程序-底部商品推广 旧]
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad - reject-dict

    # [支付宝小程序-匿名选择弹窗]
    - ^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.nbmensa\.research\.researchservice\.consultmerge - reject-200

    # ========== 闲鱼（Goofish）部分（逐条等价转换，A 版“稳妥兜底”） ==========

    # [host-suffix iyes.youku.com 拦截]
    - ^https?:\/\/[^\/]*iyes\.youku\.com\/ - reject-200

    # [开屏广告 splash.ads]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop.*splash\.ads - reject-dict

    # [开屏通用曝光 idle.ad.expose]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose - reject-200

    # ====== 以下原本是 jsonjq-response-body 的“精修”，A 版统一做“安全精简/拒绝”处理 ======
    # 说明：这些接口多数是“推荐/Tab/信息流”容器，直接拒绝会使相关区块为空/不展示，达到去广告效果但可能少量功能块缺失
    # 你若要“保留功能、仅去广告项”，用下方 B 版（脚本等价）。

    # [首页右下角悬浮球：把 strategies 置空]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list - reject-dict

    # [首页顶部Tab：移除省钱 Tab]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.circle\.list - reject-dict

    # [首页信息流 nextfresh：只保留第一项 + sections 仅 item]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh - reject-dict

    # [搜索填词：置空 singleShadeWords]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade - reject-dict

    # [猜你喜欢：置空 cardList]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.item\.search\.activate - reject-dict

    # [搜索发现：删除 resultList]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.discover - reject-dict

    # [我的页面：只保留 head/user/trade 区，其他清空]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.user\.page\.my\.adapter - reject-dict

    # [我的页信息流：删除 sections]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds - reject-dict

    # [本地信息流：只保留 item 类型]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.home - reject-dict

    # [搜索结果信息流：只保留 biz_type=item]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search - reject-dict

    # [商品底部推荐：剔除 mamaAD]
    - ^https?:\/\/(g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.recommend - reject-dict
